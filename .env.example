POSTGRES_USER=lockin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lockin

# Must be at least 32 random characters, or the API won't start. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Sign in with Google / Apple. Leave empty until the mobile app exists:
# the API runs fine without them, those sign-in endpoints are just switched off.
# GOOGLE_CLIENT_IDS is a JSON list, one client id per app build (Android, iOS, web).
# GOOGLE_CLIENT_IDS=["1234-abc.apps.googleusercontent.com"]
# APPLE_BUNDLE_ID=com.example.lockinmode
