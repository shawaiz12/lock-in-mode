POSTGRES_USER=lockin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lockin

# Must be at least 32 random characters, or the API won't start. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Sign in with Google / Apple. Leave empty until the mobile app exists:
# the API runs fine without them, those sign-in endpoints are just switched off.
# GOOGLE_CLIENT_IDS is a JSON list, one client id per app build (Android, iOS, web).
# GOOGLE_CLIENT_IDS=["1234-abc.apps.googleusercontent.com"]
# APPLE_BUNDLE_ID=com.example.lockinmode

# Redis. The default (redis://localhost:6379/0) suits running the API on your machine;
# docker compose sets it to the redis service for the api container.
# Hosted (Upstash): rediss://… (two s's = TLS). redis:// to another machine is refused.
# REDIS_URL=redis://localhost:6379/0

# Deleting accounts (ADR 0024): how often, in seconds, the API erases accounts whose 30 days
# are over. 0 switches the hourly cleanup off (signing in still erases a due account).
# ACCOUNT_CLEANUP_INTERVAL_SECONDS=3600

# Guests (ADR 0027): days a guest's sign-in lasts after the app last used it. Google/Apple
# accounts use the 60-day default; they can always sign in again.
# GUEST_REFRESH_TOKEN_TTL_DAYS=365

# "Download my data" (ADR 0027): downloads allowed per account per hour.
# EXPORT_RATE_LIMIT_PER_HOUR=3

# --- Hosting (ADR 0028, 0030, 0031). Locally, leave these out. On Vercel, set them there. ---
# Encryption to Postgres: prefer (local default) | disable | require | verify-full.
# Hosted Postgres must use verify-full: encrypted, and the server's certificate and name
# are checked.
# POSTGRES_SSLMODE=verify-full

# The CA to trust INSTEAD of the system's, as PEM text (needs verify-full). Supabase signs
# with its own CA: paste the certificate from Supabase → Database settings → SSL
# Configuration. One line with literal \n between lines also works. Empty: system CAs.
# POSTGRES_SSL_ROOT_CERT="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----"

# Behind a transaction pooler (Supabase port 6543, the API on Vercel): no prepared
# statements, and no connection pool of the app's own. Migrations use port 5432 without it.
# POSTGRES_TRANSACTION_POOLER=true

# How many proxies sit in front of the API. 0 locally. 1 on Vercel: the real caller is the
# last X-Forwarded-For entry, which the platform's proxy sets (earlier ones can be faked).
# TRUSTED_PROXY_HOPS=1

# Which commit is running, shown by /health/live. The deploy job sets it (vercel --env).
# APP_VERSION=dev
