# Where the app finds the API (read once when the bundle is built: restart `npx expo start`
# after changing it). Copy this file to .env and pick ONE line.

# The hosted API (docs/deploy.md). Works from any network, phone data included.
EXPO_PUBLIC_API_URL=https://p01--api--abcd1234.code.run

# Or the API on your computer (docker compose up), phone on the same Wi-Fi. Use the
# computer's LAN address (Linux: `hostname -I`; Windows: `ipconfig`), never localhost:
# on the phone, localhost is the phone itself.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
